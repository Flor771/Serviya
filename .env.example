# ==========================================
# CHAMBA RD — Variables de Entorno de Ejemplo
# ==========================================

# Entorno de ejecución (development / production)
ENVIRONMENT=development
APP_NAME="CHAMBA RD API"

# Base de Datos PostgreSQL
# Local: postgresql://chamba_user:chamba_pass@localhost:5432/chambard
# Render: Asignado automáticamente mediante DATABASE_URL
DATABASE_URL=postgresql://chamba_user:chamba_pass@localhost:5432/chambard

# Seguridad y Autenticación JWT (Generar una clave de al menos 32 caracteres)
SECRET_KEY=genera_tu_clave_secreta_jwt_aqui_para_produccion_rd
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Configuración de Negocio (Comisión de plataforma, ej: 0.10 = 10%)
DEFAULT_COMMISSION_RATE=0.10

# Inicialización Segura del Primer Administrador (backend/seed.py)
# Configurar en el Dashboard de Render -> Environment Variables
ADMIN_EMAIL=admin@chambard.com
ADMIN_PASSWORD=configura_aqui_tu_contrasena_inicial_segura

# Puerto del servidor (Render lo inyecta automáticamente)
PORT=8000
